# Copy this file to ~/.config/recognition/recognition.env on the server.

# Folder received from the Android recorder through Syncthing.
AUDIO_IN_DIR=%h/sync/audio_in

# Folder sent back to Android through Syncthing.
AUDIO_OUT_DIR=%h/sync/audio_out

# Local non-synced working area for queue, chunks, state, and logs.
WORK_DIR=%h/.local/share/recognition

# Local-only GigaSTT endpoint from docker-compose.yml.
GIGASTT_URL=http://127.0.0.1:9876

# Split long recordings into chunks before sending them to GigaSTT.
MAX_CHUNK_SECONDS=120

# Ignore files that were modified too recently; Syncthing may still be writing.
STABLE_SECONDS=20

# Processing safeguards.
CURL_MAX_TIME_SECONDS=1800
OUTPUT_TIMESTAMPS=1
